        "
        alt="Rita"
      `;

  } else {

    rita.textContent = "R";

  }

}


function handlePhoto(
  person,
  file
) {

  if (!file) return;


  if (!file.type.startsWith("image/")) {

    alert(
      "Please choose a picture."
    );

    return;

  }


  const reader =
    new FileReader();


  reader.onload =
    event => {

      const image =
        new Image();


      image.onload = () => {

        /*
          Resize the photo so local storage
          doesn't get filled by a huge
          iPhone photo.
        */

        const canvas =
          document.createElement(
            "canvas"
          );


        const size = 350;

        canvas.width = size;
        canvas.height = size;


        const ctx =
          canvas.getContext("2d");


        const sourceSize =
          Math.min(
            image.width,
            image.height
          );


        const sourceX =
          (image.width -
            sourceSize) / 2;


        const sourceY =
          (image.height -
            sourceSize) / 2;


        ctx.drawImage(
          image,
          sourceX,
          sourceY,
          sourceSize,
          sourceSize,
          0,
          0,
          size,
          size
        );


        const compressed =
          canvas.toDataURL(
            "image/jpeg",
            0.78
          );


        profilePhotos[person] =
          compressed;


        if (person === "leo") {

          localStorage.setItem(
            STORAGE_LEO_PHOTO,
            compressed
          );

        } else {

          localStorage.setItem(
            STORAGE_RITA_PHOTO,
            compressed
          );

        }


        renderProfilePhotos();
        renderCalendar();

      };


      image.src =
        event.target.result;

    };


  reader.readAsDataURL(file);

}


